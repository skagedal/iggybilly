#!/usr/bin/env bash
# Put the release key where the Gradle build looks for it: the keystore
# from $ANDROID_KEYSTORE_BASE64 in $RUNNER_TEMP, and a key.properties
# naming it in mobile/android.
#
# This has to be the same key local/make-release-keystore generated, and
# whose keystore is now a GitHub secret. Android identifies an app by its
# signature, so an APK signed with any other key will not install over a
# release anyone already has -- it looks like a different app that
# happens to share a name.
set -euo pipefail

: "${ANDROID_KEYSTORE_BASE64:?not set. See 'Releasing' in mobile/README.md}"
: "${ANDROID_KEYSTORE_PASSWORD:?not set. See 'Releasing' in mobile/README.md}"
: "${RUNNER_TEMP:?not set. This runs on a GitHub runner, not here.}"

root="$(cd "$(dirname "$0")/.." && pwd)"

# Outside the checkout, so no later step can sweep it into an artifact.
keystore="$RUNNER_TEMP/iggybilly-release.jks"

printf '%s' "$ANDROID_KEYSTORE_BASE64" | base64 -d > "$keystore"
chmod 600 "$keystore"

umask 077
cat > "$root/mobile/android/key.properties" <<PROPERTIES
# Generated by ci/setup-android-signing.
storeFile=$keystore
storePassword=$ANDROID_KEYSTORE_PASSWORD
keyAlias=iggybilly
keyPassword=$ANDROID_KEYSTORE_PASSWORD
PROPERTIES
