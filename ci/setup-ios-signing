#!/usr/bin/env bash
#
# Put everything xcodebuild needs to sign an App Store build on the
# runner: the distribution certificate in a keychain of its own, the
# provisioning profile where Xcode looks for it, and the two generated
# files that point the build at both.
#
# Signing is switched to manual here, and only here. Locally the app is
# signed automatically by Xcode against a logged-in Apple ID, which a
# runner has no way to be; mobile/ios/Flutter/Release.xcconfig includes
# Signing.xcconfig if it exists, and that is the hook both this and
# local/build-to-phone write through.
#
# Nothing is cleaned up afterwards. The runner is destroyed at the end of
# the job, which is the only cleanup worth trusting.

set -euo pipefail

: "${IOS_DIST_CERT_P12_BASE64:?not set. See 'Releasing' in mobile/README.md}"
: "${IOS_DIST_CERT_PASSWORD:?not set. See 'Releasing' in mobile/README.md}"
: "${IOS_PROVISIONING_PROFILE_BASE64:?not set. See 'Releasing' in mobile/README.md}"
: "${IOS_TEAM_ID:?not set. See 'Releasing' in mobile/README.md}"
: "${RUNNER_TEMP:?not set. This runs on a GitHub runner, not here.}"
: "${GITHUB_ENV:?not set. This runs on a GitHub runner, not here.}"

root="$(cd "$(dirname "$0")/.." && pwd)"
bundle_id="tech.skagedal.iggybilly"

certificate="$RUNNER_TEMP/distribution.p12"
profile="$RUNNER_TEMP/profile.mobileprovision"
keychain="$RUNNER_TEMP/signing.keychain-db"
keychain_password="$(openssl rand -base64 24)"

printf '%s' "$IOS_DIST_CERT_P12_BASE64" | base64 -d > "$certificate"
printf '%s' "$IOS_PROVISIONING_PROFILE_BASE64" | base64 -d > "$profile"

security create-keychain -p "$keychain_password" "$keychain"
security set-keychain-settings -lut 21600 "$keychain"
security unlock-keychain -p "$keychain_password" "$keychain"
security import "$certificate" -k "$keychain" -P "$IOS_DIST_CERT_PASSWORD" \
    -T /usr/bin/codesign

# Without this, codesign meets a keychain prompt that nobody is there to
# answer, and the build hangs until the job times out rather than failing.
security set-key-partition-list -S apple-tool:,apple:,codesign: \
    -s -k "$keychain_password" "$keychain" > /dev/null

# Added to the search list rather than replacing it: the chain that the
# certificate is validated against lives in the default keychains.
searched=()
while read -r line; do
    searched+=("$(printf '%s' "$line" | sed 's/^ *"//; s/"$//')")
done < <(security list-keychains -d user)
security list-keychains -d user -s "$keychain" "${searched[@]}"

# The profile's own name is what the build setting and the export options
# have to say, and it is inside the profile -- so read it from there
# rather than making it a fifth thing to keep in step by hand.
decoded="$RUNNER_TEMP/profile.plist"
security cms -D -i "$profile" > "$decoded"
profile_name="$(plutil -extract Name raw -o - "$decoded")"
profile_uuid="$(plutil -extract UUID raw -o - "$decoded")"

# Both locations: Xcode 16 moved the directory it reads and still reads
# the old one.
for directory in \
    "$HOME/Library/MobileDevice/Provisioning Profiles" \
    "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles"; do
    mkdir -p "$directory"
    cp "$profile" "$directory/$profile_uuid.mobileprovision"
done

cat > "$root/mobile/ios/Flutter/Signing.xcconfig" <<CONFIG
// Generated by ci/setup-ios-signing.
DEVELOPMENT_TEAM = $IOS_TEAM_ID
CODE_SIGN_STYLE = Manual
PROVISIONING_PROFILE_SPECIFIER = $profile_name
// Both spellings: the project sets the sdk-conditional one to "iPhone
// Developer", and an unconditional value here does not displace it.
CODE_SIGN_IDENTITY = Apple Distribution
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Distribution
CONFIG

export_options="$RUNNER_TEMP/ExportOptions.plist"
cat > "$export_options" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>$IOS_TEAM_ID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>$bundle_id</key>
		<string>$profile_name</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
PLIST

plutil -lint "$export_options" > /dev/null

echo "IGGYBILLY_EXPORT_OPTIONS=$export_options" >> "$GITHUB_ENV"

echo "setup-ios-signing: signing as '$profile_name' for team $IOS_TEAM_ID" >&2
