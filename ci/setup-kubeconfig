#!/usr/bin/env bash
# Decode the base64-encoded kubeconfig held in $KUBECONFIG_BASE64 to a
# temp file and point subsequent workflow steps at it via $GITHUB_ENV.
# The kubeconfig embeds the cluster-admin ci-deployer SA token from the
# `ci` namespace -- minted by skagedal.tech/host/mint-kubeconfig. Same
# secret value as the skagedal.tech / blogdans / bonband repos use.
set -euo pipefail

mkdir -p "$RUNNER_TEMP/kube"
printf '%s' "$KUBECONFIG_BASE64" | base64 -d > "$RUNNER_TEMP/kube/config"
chmod 600 "$RUNNER_TEMP/kube/config"
echo "KUBECONFIG=$RUNNER_TEMP/kube/config" >> "$GITHUB_ENV"
