#!/usr/bin/env bash
#
# Hand the built .ipa to App Store Connect, which is what puts it in
# TestFlight. Testers get it within minutes of processing finishing;
# there is no review for internal testers, and for an external group only
# the first build of a version is reviewed.
#
# altool authenticates with an App Store Connect API key, which it looks
# for by name in one of a few fixed directories rather than taking a
# path. Hence writing the key out where it will be found.

set -euo pipefail

: "${APP_STORE_CONNECT_KEY_ID:?not set. See 'Releasing' in mobile/README.md}"
: "${APP_STORE_CONNECT_ISSUER_ID:?not set. See 'Releasing' in mobile/README.md}"
: "${APP_STORE_CONNECT_PRIVATE_KEY:?not set. See 'Releasing' in mobile/README.md}"

root="$(cd "$(dirname "$0")/.." && pwd)"

keys="$HOME/.appstoreconnect/private_keys"
mkdir -p "$keys"
(umask 077; printf '%s\n' "$APP_STORE_CONNECT_PRIVATE_KEY" \
    > "$keys/AuthKey_$APP_STORE_CONNECT_KEY_ID.p8")

ipa="$(find "$root/mobile/build/ios/ipa" -maxdepth 1 -name '*.ipa' | head -n 1)"
[ -n "$ipa" ] || {
    echo "upload-to-testflight: the build produced no .ipa" >&2
    exit 1
}

echo "upload-to-testflight: uploading $(basename "$ipa")" >&2
xcrun altool --upload-app --type ios --file "$ipa" \
    --apiKey "$APP_STORE_CONNECT_KEY_ID" \
    --apiIssuer "$APP_STORE_CONNECT_ISSUER_ID"
