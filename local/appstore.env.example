# The App Store Connect API key. local/make-ios-signing authenticates
# with it to have a certificate and a profile issued, and CI uploads
# builds with the same one.
#
# Copy this to local/appstore.env, or symlink your own file over it —
# that path is gitignored, because this repository is public and none of
# the values below belong to anyone but you.
#
#   ln -s ~/code/dotfiles/mobile/appstore.env local/appstore.env
#
# Make the key in App Store Connect under Users and Access →
# Integrations → App Store Connect API. Give it the Admin role: App
# Manager is enough to upload a build, but not to have a certificate
# issued. The .p8 downloads once and never again.
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX

# Shown above the list of keys, and the same for every key on the
# account.
APP_STORE_CONNECT_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Wherever you put the .p8 — anywhere but this repository. A leading ~ is
# expanded; nothing else is.
APP_STORE_CONNECT_KEY_FILE=~/.apple-signing/AuthKey_XXXXXXXXXX.p8
