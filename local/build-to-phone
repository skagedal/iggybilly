#!/usr/bin/env bash
#
# Build the app and install it on a phone, without opening Xcode.
#
# It installs as iggybilly Dev, under its own bundle id and with a DEV band
# on its icon, so it sits beside the TestFlight build rather than
# replacing it.
#
#   ./local/build-to-phone            release build (the default)
#   ./local/build-to-phone --debug    debug build, for attaching a debugger
#
# Which phone and which Apple team come from local/devices.env, which is
# gitignored: this repository is public and neither value belongs in it.
# Copy local/devices.env.example, or symlink your own file over that path.
#
# Flutter's own install step fails with a generic "Try launching Xcode"
# where devicectl succeeds, so the two are done separately.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
env_file="$root/local/devices.env"
signing="$root/mobile/ios/Flutter/Signing.xcconfig"

die() {
    echo "build-to-phone: $*" >&2
    exit 1
}

require() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$1 not found on PATH. $2"
}

mode="release"
case "${1:-}" in
    --debug) mode="debug" ;;
    --release | "") ;;
    *) die "unknown option: $1 (--debug or --release)" ;;
esac

[ -f "$env_file" ] || die "no local/devices.env.
Copy local/devices.env.example to it, or symlink your own:
  ln -s ~/code/dotfiles/mobile/devices.env local/devices.env"

# shellcheck source=/dev/null
. "$env_file"

: "${IOS_DEVICE:?not set in local/devices.env}"
: "${IOS_TEAM:?not set in local/devices.env}"

require fvm "The Flutter SDK is pinned per app with fvm; see https://fvm.app."
require xcrun "Install the Xcode command line tools: xcode-select --install."

# Automatic signing needs to be told the team, and this is the only place
# it is written down. Regenerated every run so it can never drift from
# local/devices.env, and gitignored so it never lands in a commit.
#
# The first build under the development id has Xcode register it with
# Apple and make a profile for it, which needs nothing beyond the team.
cat > "$signing" <<EOF
// Generated by local/build-to-phone. Edit local/devices.env instead.
DEVELOPMENT_TEAM = $IOS_TEAM
PRODUCT_BUNDLE_IDENTIFIER = tech.skagedal.iggybilly.dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev
APP_DISPLAY_NAME = iggybilly Dev
EOF

cd "$root/mobile"

echo "build-to-phone: building ($mode)" >&2
fvm flutter build ios "--$mode"

app="build/ios/iphoneos/Runner.app"
[ -d "$app" ] || die "the build finished but produced no $app"

echo "build-to-phone: installing on $IOS_DEVICE" >&2
xcrun devicectl device install app --device "$IOS_DEVICE" "$app"

echo "build-to-phone: done — launch iggybilly Dev from the home screen" >&2
