# Which phone to install on, and which Apple team signs the build.
#
# Copy this to local/device.env, or symlink your own file over it — that
# path is gitignored, because this repository is public and neither value
# below belongs to anyone but you.
#
#   ln -s ~/dotfiles/iggybilly-device.env local/device.env
#
# The device id is the one `xcrun devicectl list devices` prints, or
# `fvm flutter devices` for a paired phone. It is not the simulator UDID.
IOS_DEVICE=00000000-000000000000000A

# Your Apple team id: the OU field of the signing certificate, *not* the
# value in brackets after the name in `security find-identity -v -p codesigning`.
# To read it:
#
#   security find-certificate -c "Apple Development: you@example.com" -p \
#     | openssl x509 -noout -subject | tr ',' '\n' | sed -n 's/.*OU *= *//p'
IOS_TEAM=AAAAAAAAAA
