#!/usr/bin/env bash
#
# Make the keystore that signs release builds of the Android app, and the
# mobile/android/key.properties that points the Gradle build at it.
#
#   ./local/make-release-keystore [path-to-keystore]
#
# The default path is outside the repository on purpose. The key is the
# app's identity: Android refuses to install an update signed by a
# different key, so losing this file means everyone who has the app has
# to uninstall it before they can take another build. Getting it off this
# machine is ./local/seal-signing-backup, which this ends by telling you
# to run.
#
# The password is generated here rather than asked for, because nobody
# needs to type it: Gradle reads it from key.properties locally and from
# a GitHub secret in CI. Both of those this script sets up.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
properties="$root/mobile/android/key.properties"
alias="iggybilly"

die() {
    echo "make-release-keystore: $*" >&2
    exit 1
}

case "${1:-}" in
    -h | --help)
        awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$0"
        exit 0
        ;;
    -*) die "unknown option: $1 (only a keystore path is taken)" ;;
esac

keystore="${1:-$HOME/.android-keystores/iggybilly-release.jks}"

command -v keytool >/dev/null 2>&1 ||
    die "keytool not found on PATH. It comes with the JDK; on macOS, \`brew install --cask temurin\`."
command -v openssl >/dev/null 2>&1 ||
    die "openssl not found on PATH."

# Never silently. A second keystore at the same path would be a different
# key, and would look like this script had simply run twice.
[ -e "$keystore" ] &&
    die "$keystore already exists.
That file is an identity, not a build artifact: replacing it breaks
updates for everyone who has the app. Pass a different path if you
really do want a second one."

[ -e "$properties" ] &&
    die "$properties already exists.
Delete it if the keystore it names is gone, then run this again."

mkdir -p "$(dirname "$keystore")"

password="$(openssl rand -base64 24)"

# -dname non-interactively, so the run needs no input. None of these
# fields are shown to anyone; Android only ever compares the key itself.
keytool -genkeypair \
    -alias "$alias" \
    -keyalg RSA \
    -keysize 4096 \
    -validity 10000 \
    -keystore "$keystore" \
    -storetype PKCS12 \
    -storepass "$password" \
    -keypass "$password" \
    -dname "CN=iggybilly, O=skagedal, C=SE"

chmod 600 "$keystore"

# Beside the keystore, the way make-ios-signing keeps the .p12's password
# beside the bundle. key.properties stays in the repository and is not
# backed up, so a keystore whose password is only written there is one no
# backup can open.
(umask 077; printf '%s' "$password" > "$keystore.password")

umask 077
cat > "$properties" <<PROPERTIES
# Generated by local/make-release-keystore. Gitignored: this repository
# is public. The keystore itself is at the path below, outside the repo.
storeFile=$keystore
storePassword=$password
keyAlias=$alias
keyPassword=$password
PROPERTIES

cat >&2 <<MESSAGE

make-release-keystore: done.

  keystore    $keystore
  properties  $properties
  password    $keystore.password

Two things left, in this order:

1. Back the keystore up, which is one command:

     ./local/seal-signing-backup --push

   It seals the whole of $(dirname "$keystore"), the password beside the
   keystore included, into an age-encrypted archive in the private
   dotfiles repository. Run it again whenever any of this changes.

2. Give CI the same key, so the APKs it builds can install over the ones
   you build here. Piped rather than pasted, to keep both values out of
   the shell history:

     base64 < "$keystore" | gh secret set ANDROID_KEYSTORE_BASE64
     sed -n 's/^storePassword=//p' "$properties" | gh secret set ANDROID_KEYSTORE_PASSWORD
MESSAGE
