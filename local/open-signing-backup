#!/usr/bin/env bash
#
# Unpack what local/seal-signing-backup sealed.
#
#   ./local/open-signing-backup            restore into ~
#   ./local/open-signing-backup ~/check    unpack somewhere harmless, to check the backup
#
# Refuses if .android-keystores or .apple-signing already exists in the
# destination: an old archive restored over current material would replace
# an app's identity with a former one. Move them aside first if you mean it.
#
# Needs an age identity the archive was sealed to; IDENTITY overrides the
# default, e.g. the key kept off a machine that is now gone.
#
# CI holds its own copies as repository secrets. On a replacement machine,
# re-run ./local/make-ios-signing to set the iOS ones, and recreate
# mobile/android/key.properties, which is not in the archive.

set -euo pipefail

archive="$HOME/code/dotfiles/secrets/mobile-signing.tar.gz.age"
identity="${IDENTITY:-$HOME/.config/age/identity.txt}"
destination="${1:-$HOME}"

die() {
    echo "open-signing-backup: $*" >&2
    exit 1
}

command -v age > /dev/null || die "age not found. On macOS, \`brew install age\`."
[ -f "$archive" ] || die "no $archive. Clone or pull the dotfiles repository."
[ -f "$identity" ] || die "no identity at $identity. Set IDENTITY to one the archive was sealed to."

for dir in .android-keystores .apple-signing; do
    [ ! -e "$destination/$dir" ] || die "$destination/$dir already exists; move it aside first."
done

mkdir -p "$destination"
age --decrypt --identity "$identity" "$archive" | tar -xzf - -C "$destination"
echo "open-signing-backup: restored into $destination" >&2
