#!/usr/bin/env bash
#
# Encrypt ~/.android-keystores and ~/.apple-signing with age into the
# private dotfiles repository, so the signing material outlives this laptop.
#
#   ./local/seal-signing-backup
#
# The archive is encrypted to every key in secrets/recipients.txt, and
# there must be at least two: this machine's, and one kept off it.
# Otherwise losing the laptop also loses the key that opens its backup.
# See local/signing-backup.recipients.example.
#
# The App Store Connect .p8 in ~/.apple-signing goes in too. Unlike the
# keystore and the distribution key, it can be revoked and replaced.
#
# tar is piped straight into age; no plaintext is written to disk.

set -euo pipefail

backup_dir="$HOME/code/dotfiles/secrets"
recipients="$backup_dir/recipients.txt"
identity="$HOME/.config/age/identity.txt"
archive="$backup_dir/mobile-signing.tar.gz.age"

die() {
    echo "seal-signing-backup: $*" >&2
    exit 1
}

command -v age > /dev/null || die "age not found. On macOS, \`brew install age\`."

[ -f "$recipients" ] || die "no $recipients. See local/signing-backup.recipients.example."
count="$(grep -cv -e '^[[:space:]]*$' -e '^[[:space:]]*#' "$recipients" || true)"
[ "$count" -ge 2 ] || die "$recipients needs at least two recipients, one of them kept off this machine."

entries=()
for dir in .android-keystores .apple-signing; do
    if [ -d "$HOME/$dir" ]; then
        entries+=("$dir")
    fi
done
[ ${#entries[@]} -gt 0 ] || die "neither ~/.android-keystores nor ~/.apple-signing exists."

for keystore in "$HOME"/.android-keystores/*.jks; do
    if [ -e "$keystore" ] && [ ! -e "$keystore.password" ]; then
        echo "seal-signing-backup: warning: no $keystore.password, so nobody could open that keystore from the backup" >&2
    fi
done

temp="$(mktemp "$backup_dir/.mobile-signing.XXXXXX")"
trap 'rm -f "$temp"' EXIT

tar -czf - -C "$HOME" "${entries[@]}" | age --recipients-file "$recipients" --output "$temp"

if [ -f "$identity" ]; then
    age --decrypt --identity "$identity" "$temp" | tar -tzf - > /dev/null ||
        die "the new archive did not open with $identity; the old one is untouched."
fi

chmod 644 "$temp"
mv "$temp" "$archive"
trap - EXIT

cat >&2 <<MESSAGE
seal-signing-backup: sealed ${entries[*]} to $archive. To get it off this machine:

  git -C "$backup_dir" add mobile-signing.tar.gz.age
  git -C "$backup_dir" commit -m "Seal signing material"
  git -C "$backup_dir" push
MESSAGE
